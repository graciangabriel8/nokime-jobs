# Nokime Jobs on OVH (Apache), since the move from GitHub Pages.
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Nokime Jobs is closed for now (3 Nov 2026): the home (index.html) says it comes back soon, and every other page goes
# there for a while (302, not 301: the pages come back). The legal notice stays. The forms' scripts answer 503, so nothing
# can be posted, counted or signed up to; the private page (api/compte.php) and the daily tasks stay. The open home waits
# in _home-ouvert.html. Reopening = reverting the commit that closed the site.
RewriteRule ^(_home-ouvert\.html|publier|ecoles|questionnaire|contact|charte|hirondelle|conseils|o|compte|conditions-comptes)(/.*)?$ / [R=302,L,QSD]
RewriteRule ^api/(offre\.php|postuler\.php|auth/) - [R=503,L]

# A Git deploy may leave its folder in the web root: never serve it.
RedirectMatch 404 ^/\.git(/|$)
# api/_*.php are helpers and the daily task: never run from the web.
RedirectMatch 404 ^/api/_

# The account pages never show inside another site's frame (clickjacking).
<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY" "expr=%{REQUEST_URI} =~ m#^/compte/#"
  Header always set Content-Security-Policy "frame-ancestors 'none'" "expr=%{REQUEST_URI} =~ m#^/compte/#"
</IfModule>

# No folder listings (tools/, css/, js/, fonts/, api/…): a folder without index.html answers 403.
Options -Indexes

# A css/ or js/ file loaded with ?v=N never changes under that address (tools/bump.py raises N on every change
# and tools/check.py refuses a change without it), so browsers may keep it a year. Unversioned files keep the host's default.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{QUERY_STRING} =~ /^v=[0-9]+$/"
  </FilesMatch>
</IfModule>

# Any missing path, at any depth, gets the site's own page (its links are root-absolute).
ErrorDocument 404 /404.html

AddType font/woff2 .woff2
AddDefaultCharset UTF-8
AddCharset UTF-8 .css .js .xml .txt
